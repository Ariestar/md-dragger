{
  "name": "md-dragger",
  "version": "2.0.2",
  "description": "Core markdown block drag-and-drop engine",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ariestar/md-dragger.git"
  },
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.mjs",
  "types": "./dist/npm/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/npm/types/index.d.mts",
        "default": "./dist/npm/index.mjs"
      },
      "require": {
        "types": "./dist/npm/types/index.d.cts",
        "default": "./dist/npm/index.cjs"
      }
    },
    "./domain": {
      "source": "./src/domain/index.ts",
      "import": {
        "types": "./dist/npm/types/domain/index.d.mts",
        "default": "./dist/npm/domain.mjs"
      },
      "require": {
        "types": "./dist/npm/types/domain/index.d.cts",
        "default": "./dist/npm/domain.cjs"
      }
    },
    "./runtime": {
      "source": "./src/runtime/index.ts",
      "import": {
        "types": "./dist/npm/types/runtime/index.d.mts",
        "default": "./dist/npm/runtime.mjs"
      },
      "require": {
        "types": "./dist/npm/types/runtime/index.d.cts",
        "default": "./dist/npm/runtime.cjs"
      }
    },
    "./runtime/modules": {
      "source": "./src/runtime/modules/index.ts",
      "import": {
        "types": "./dist/npm/types/runtime/modules/index.d.mts",
        "default": "./dist/npm/runtime/modules.mjs"
      },
      "require": {
        "types": "./dist/npm/types/runtime/modules/index.d.cts",
        "default": "./dist/npm/runtime/modules.cjs"
      }
    },
    "./adapter/codemirror": {
      "source": "./src/adapter/codemirror/index.ts",
      "import": {
        "types": "./dist/npm/types/adapter/codemirror/index.d.mts",
        "default": "./dist/npm/adapter/codemirror.mjs"
      },
      "require": {
        "types": "./dist/npm/types/adapter/codemirror/index.d.cts",
        "default": "./dist/npm/adapter/codemirror.cjs"
      }
    }
  },
  "files": [
    "dist/npm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-core-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check src",
    "format": "biome format --write",
    "format:check": "biome format",
    "test": "vitest run",
    "lint:pkg": "publint",
    "check:types": "attw --pack --profile node16",
    "prepare": "husky"
  },
  "lint-staged": {
    "{src,scripts}/**/*.{ts,mjs}": "biome check --write",
    "./*.mjs": "biome check --write",
    "./*.json": "biome format --write",
    ".vscode/*.json": "biome format --write"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "keywords": [
    "markdown",
    "drag-drop",
    "blocks",
    "codemirror"
  ],
  "author": "Ariestar",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.19.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.10",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.9",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "publint": "^0.3.24",
    "tslib": "^2.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
