{
  "name": "md-dragger",
  "version": "1.3.4",
  "description": "Core markdown block drag-and-drop engine",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ariestar/obsidian-dragger"
  },
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.mjs",
  "types": "./dist/npm/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/npm/types/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/npm/index.mjs",
      "require": "./dist/npm/index.cjs"
    },
    "./domain": {
      "types": "./dist/npm/types/domain.d.ts",
      "source": "./src/domain.ts",
      "import": "./dist/npm/domain.mjs",
      "require": "./dist/npm/domain.cjs"
    },
    "./drag": {
      "types": "./dist/npm/types/drag.d.ts",
      "source": "./src/drag.ts",
      "import": "./dist/npm/drag.mjs",
      "require": "./dist/npm/drag.cjs"
    },
    "./drag/runtime": {
      "types": "./dist/npm/types/drag-runtime.d.ts",
      "source": "./src/drag-runtime.ts",
      "import": "./dist/npm/drag-runtime.mjs",
      "require": "./dist/npm/drag-runtime.cjs"
    },
    "./markdown": {
      "types": "./dist/npm/types/markdown.d.ts",
      "source": "./src/markdown.ts",
      "import": "./dist/npm/markdown.mjs",
      "require": "./dist/npm/markdown.cjs"
    }
  },
  "files": [
    "dist/npm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-core-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "markdown",
    "drag-drop",
    "blocks",
    "codemirror"
  ],
  "author": "Ariestar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "esbuild": "^0.17.3",
    "tslib": "^2.4.0",
    "typescript": "^4.9.0"
  }
}
