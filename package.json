{
  "name": "md-dragger",
  "version": "1.3.4",
  "description": "Core markdown block drag-and-drop engine",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ariestar/obsidian-dragger.git"
  },
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.mjs",
  "types": "./dist/npm/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/npm/types/index.d.mts",
        "default": "./dist/npm/index.mjs"
      },
      "require": {
        "types": "./dist/npm/types/index.d.cts",
        "default": "./dist/npm/index.cjs"
      }
    },
    "./domain": {
      "source": "./src/domain.ts",
      "import": {
        "types": "./dist/npm/types/domain.d.mts",
        "default": "./dist/npm/domain.mjs"
      },
      "require": {
        "types": "./dist/npm/types/domain.d.cts",
        "default": "./dist/npm/domain.cjs"
      }
    },
    "./runtime": {
      "source": "./src/runtime.ts",
      "import": {
        "types": "./dist/npm/types/runtime.d.mts",
        "default": "./dist/npm/runtime.mjs"
      },
      "require": {
        "types": "./dist/npm/types/runtime.d.cts",
        "default": "./dist/npm/runtime.cjs"
      }
    },
    "./adapter/codemirror": {
      "source": "./src/adapter/codemirror.ts",
      "import": {
        "types": "./dist/npm/types/adapter/codemirror.d.mts",
        "default": "./dist/npm/adapter/codemirror.mjs"
      },
      "require": {
        "types": "./dist/npm/types/adapter/codemirror.d.cts",
        "default": "./dist/npm/adapter/codemirror.cjs"
      }
    }
  },
  "files": [
    "dist/npm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-core-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:pkg": "publint",
    "check:types": "attw --pack --profile node16"
  },
  "peerDependencies": {
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0"
  },
  "keywords": [
    "markdown",
    "drag-drop",
    "blocks",
    "codemirror"
  ],
  "author": "Ariestar",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@arethetypeswrong/cli": "^0.18.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "esbuild": "^0.17.3",
    "publint": "^0.3.15",
    "tslib": "^2.4.0",
    "typescript": "^4.9.0"
  }
}
