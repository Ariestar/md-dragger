{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist/npm/types",
    "rootDir": "src",
    "stripInternal": true
  },
  "include": [
    "src/index.ts",
    "src/domain.ts",
    "src/drag.ts",
    "src/drag-runtime.ts",
    "src/markdown.ts",
    "src/domain/**/*.ts",
    "src/drag/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts"
  ]
}
